{
  "mcpServers": {
    "cachelayer": {
      "type": "http",
      "url": "https://api.cachelayer.org/mcp/http",
      "headers": {
        "Authorization": "Bearer ${CACHELAYER_KEY}"
      }
    },
    "cachelayer-agent": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/agent/run.sh"
      ]
    }
  }
}
