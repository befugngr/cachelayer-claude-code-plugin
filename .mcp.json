{
  "mcpServers": {
    "cachelayer": {
      "type": "http",
      "url": "https://api.cachelayer.org/mcp/http",
      "headers": {
        "Authorization": "Bearer ${CACHELAYER_KEY}"
      }
    },
    "cachelayer-agent": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/cachelayer_tools/run_mcp.sh"
      ],
      "env": {
        "CACHELAYER_WORKSPACE_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
